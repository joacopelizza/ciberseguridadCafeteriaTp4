# Copiar a .env y reemplazar los marcadores por secretos aleatorios únicos.

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app
DB_PASSWORD=
POSTGRES_PASSWORD=

# Contraseñas iniciales de las cuentas de demostración (mínimo 24 caracteres).
ADMIN_INITIAL_PASSWORD=
OWNER_INITIAL_PASSWORD=
BARISTA_INITIAL_PASSWORD=
MOZO_INITIAL_PASSWORD=
CLIENT_INITIAL_PASSWORD=

UPLOADS_DIR=/app/uploads
